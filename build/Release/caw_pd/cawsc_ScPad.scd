// SuperCollider pad. depth = automation lane (\depth.kr). The 3rd value (slow LFO) is sent to Csound Voice1, channel input2 (filter cutoff).

var depth = \depth.kr(0.5);
var lfo = SinOsc.kr(0.4).range(300, 3000);
var wobble = 1 + (SinOsc.kr(0.2) * 0.004 * depth);
var pad = Mix(SinOsc.ar([220, 277.2, 329.6] * wobble, 0, 0.05));
[pad, pad, lfo]
  }.value;
  sig = sig.asArray;
  if(sig.size == 1, { sig = [sig[0], sig[0]] });
  sig = (sig ++ (0 ! nch)).keep(nch);
  sig = sig.collect({ |s| if(s.rate == \control, { K2A.ar(s) }, { s }) });
  Out.ar(0, sig);
});
events = List.new;
