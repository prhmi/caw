ScM1
308
// MIDI: p4 = pitch, p5 = velocity (automatic). p6 = detune of the copy (from the p-line)
<caw>
midi: "on"
{p: 6, from: -0.15, to: 0.15}
</caw>
var env = EnvGen.kr(Env.adsr(0.01, 0.1, 0.7, 0.3), \gate.kr(1), doneAction: 2);
var sig = SinOsc.ar((p4 + p6).midicps, 0, 0.1 * (p5 / 127) / iRun) * env;
[sig, sig]
