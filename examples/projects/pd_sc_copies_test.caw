ScU1
256
// p4 = frequency, p5 = pan, indx = copy number, iRun = number of copies
<caw>
{p: 4, from: 300, +100}
{p: 5, from: -0.8, to: 0.8}
</caw>
var env = EnvGen.kr(Env([0, 1, 1, 0], [0.5, 4.5, 1]));
var sig = SinOsc.ar(p4, 0, 0.08 / iRun) * env;
Pan2.ar(sig, p5)
