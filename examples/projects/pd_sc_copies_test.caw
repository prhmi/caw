PdUnison
343
; Lead: plain sine, MIDI note or input1 pitch
<caw>
{chn: "input1", range: (0,127,0.1), value: 60 }
midi: "on"
</caw>
kMidi init p4
iVel = p5
if (iVel <= 0) then
  iVel = 127
endif
kNote caw "input1"
if (kMidi > 0) then
  kNote = kMidi
endif
aEnv  linen 1, 0.02, p3, 0.1
aOut  oscili 0.2 * (iVel / 127) * aEnv, cpsmidinn(kNote)
outs aOut, aOut
