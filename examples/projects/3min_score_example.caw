Cello
419
; Deep bass: driven sine
<caw>
{chn: "volume", range: (0,1,0.01), value: 0.6 }
{chn: "drive", range: (1,6,0.01), value: 2.2 }
midi: "on"
</caw>
kVol caw "volume"
kDrive caw "drive"
iMidi = p4
if (iMidi <= 0) then
  iMidi = 31
endif
iVel = p5
if (iVel <= 0) then
  iVel = 127
endif
aEnv linen 1, 0.01, p3, 0.12
aSin oscili 1, cpsmidinn(iMidi)
aOut = tanh(aSin * kDrive) * kVol * 0.3 * (iVel / 127) * aEnv
outs aOut, aOut
