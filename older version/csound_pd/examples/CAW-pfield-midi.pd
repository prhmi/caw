#N canvas 100 100 600 400 10;
#X obj 60 40 loadbang;
#X msg 60 70 220;
#X obj 60 150 osc~;
#X obj 60 190 *~ 0.08;
#X obj 60 230 dac~ 1 2;
#X obj 200 40 r \$0-caw-p6;
#X obj 320 40 notein;
#X obj 320 70 mtof;
#X text 55 290 \$0-caw-p6 controls frequency. MIDI notein also sets frequency.;
#X text 55 315 Set a p-field rule like {p: 6, from: 440} and enable MIDI.;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 3 0 4 1;
#X connect 5 0 2 0;
#X connect 6 0 7 0;
#X connect 7 0 2 0;
