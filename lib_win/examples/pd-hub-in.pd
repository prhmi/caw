#N canvas 0 0 450 300 10;
#X text 40 30 CAW hub demo: receives the shared "tempo" value (from any
clip of any language) via [r $0-cawr-tempo] and plays it as a tone.;
#X obj 60 90 r \$0-cawr-tempo;
#X obj 60 130 print tempo_from_hub;
#X obj 60 240 osc~ 220;
#X obj 60 280 *~ 0.2;
#X obj 60 310 dac~;
#X connect 0 0 1 0;
#X connect 0 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 3 0 4 1;
